# FunkAtlas local settings — copy to .env (gitignored). Never commit secrets.
# Precedence: process env var > .env > code default.

# Storage (defaults: data/funkatlas.sqlite3, logs/)
#FUNKATLAS_DB_PATH=data/funkatlas.sqlite3
#FUNKATLAS_LOG_DIR=logs

# Probe identity (default: sanitized hostname). Pseudonym-free, no PII.
#FUNKATLAS_DEVICE_ID=laptopandi

# Set to 1 to ignore .env entirely (tests do this automatically).
#FUNKATLAS_DISABLE_DOTENV=1

# Router credentials arrive with M5 (TR-064 collectors). Rule from day one:
# use a DEDICATED least-privilege read-only router user, NOT the box admin.
